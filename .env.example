# --- Tesla Fleet API (https://developer.tesla.com) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Must match "Allowed Redirect URI" in the Tesla developer app
TESLA_REDIRECT_URI=http://localhost:3000/api/auth/callback
# EU/APAC: https://fleet-api.prd.eu.vn.cloud.tesla.com   North America: https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_FLEET_API_BASE=https://fleet-api.prd.eu.vn.cloud.tesla.com
# Optional: specific car if the account has several
TESLA_VIN=
# Optional: public key PEM (alternatively put it into data/public-key.pem)
TESLA_PUBLIC_KEY=

# --- Polling ---
POLL_INTERVAL_MINUTES=10
POLL_ACTIVE_INTERVAL_MINUTES=2
# DISABLE_POLLER=1

# --- Storage / time zone (used for day/month boundaries) ---
DATABASE_PATH=./data/tesla.db
TZ=Europe/Moscow

# --- Security (recommended when exposed to the internet) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Token for /api/summary, /api/poll and /widget (?token=... or Authorization: Bearer ...)
WIDGET_TOKEN=
